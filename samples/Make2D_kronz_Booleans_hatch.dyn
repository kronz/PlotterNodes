      ],
      "FunctionSignature": "Plotter.Make2D.ByCamera@var[]..[],Autodesk.DesignScript.Geometry.Point,Autodesk.DesignScript.Geometry.Point,Autodesk.DesignScript.Geometry.Vector,double,double,double,double,double",
      "Replication": "Auto",
      "Description": "Perspective drawing of geometry from a camera with hidden lines removed (Rhino's Make2D in a perspective viewport). Lines are drawn where they pierce the image plane, a plane perpendicular to the eye-target line at imagePlaneDistance from the eye, so objects at that distance appear at true size. The field of view clips the drawing to a square window; Frame returns it.\n\nMake2D.ByCamera (geometry: var[]..[], eyePoint: Point, targetPoint: Point, upVector: Vector = null, fieldOfView: double = 60, imagePlaneDistance: double = 0, meshTolerance: double = -1, creaseAngle: double = 20, mergeTolerance: double = 0): Make2D"
    },
