      "ConcreteType": "Plotter.Canvas.CanvasShadingNode, PlotterNodes.Canvas",
      "Id": "e6170f3c5ca741a6a783ba4b55007068",
      "NodeType": "ExtensionNode",
      "Inputs": [
        {
          "Id": "0fbd9c0f0b93438b83139b6e4d53915a",
          "Name": "canvas",
          "Description": "The geometry output of a Canvas 3D node (identifies the canvas).",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "0eff30c5455841a3b0df7625f5ad3d58",
          "Name": "groundPlane",
          "Description": "Include ground bounce light and output the ground plane with its shadows.",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "1fe28ad986e84543b9269a8eed14a1e3",
          "Name": "mesh",
          "Description": "The meshes shown in the canvas, in Dynamo coordinates.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "75d456683a6a471b9fdc23b1e4af128b",
          "Name": "shade",
          "Description": "Arctic shade per mesh triangle: (sky light x sky visibility + ground bounce) x exposure, 0 = black, 1 = white. No camera fill light and no screen-space AO (they depend on the view).",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e4995032d95544ad872c61b27049f7a3",
          "Name": "groundMesh",
          "Description": "Ground plane grid under the scene.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d2db054d0a0f47e88356962d2ccc071d",
          "Name": "groundShade",
          "Description": "Shade per ground triangle: 1 = open sky, lower = shadow (ground shadow strength applied).",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "25266003975948ec9339fed9fe3ba263",
          "Name": "status",
          "Description": "What the values were computed from, or why there are none.",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Replication": "Disabled",
      "Description": "Ambient occlusion from a Canvas 3D window as data: the canvas meshes as one mesh with an Arctic light/dark value per triangle (0 black, 1 white), and the ground plane with its shadow values. Wire the geometry output of a Canvas 3D node into it; the canvas must be open in Arctic display with sky shadows on."
    },
