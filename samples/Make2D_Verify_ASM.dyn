      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// Inputs: edit these. side and R match the test suite shape (cube 10, sphere radius 6.8).\nside = 10;\nR = 6.8;\neye = Point.ByCoordinates(28, -38, 22);\ntarget = Point.ByCoordinates(0, 0, 0);\nfov = 40;\nmeshTol = -1;\ncaptureFolder = \"D:/Drawing/PlotterNodes/tests/make2d/captured\";\n// The solid\ncube = Cuboid.ByLengths(Point.Origin(), side, side, side);\nball = Sphere.ByCenterPointRadius(Point.Origin(), R);\nsolid = cube.Difference(ball);\n// Ground truth from ASM: sample every B-rep edge and cast a line to the eye\nedgeCurves = solid.Edges.CurveGeometry;\nsamples = edgeCurves.PointsAtEqualChordLength(60);\ntoEye = Vector.ByTwoPoints(samples, eye).Normalized();\nsightLines = Line.ByStartPointEndPoint(samples.Translate(toEye, side * 0.002), eye);\nasmHidden = sightLines.DoesIntersect(solid);\n// Project the samples the way Make2D.ByCamera does\nfwd = Vector.ByTwoPoints(eye, target).Normalized();\nrgt = fwd.Cross(Vector.ZAxis()).Normalized();\nupv = rgt.Cross(fwd);\ndist = eye.DistanceTo(target);\noffset = 2 * side;\nrel = Vector.ByTwoPoints(eye, samples);\ndepth = rel.Dot(fwd);\ndrawn = Point.ByCoordinates(rel.Dot(rgt) * dist / depth + offset, rel.Dot(upv) * dist / depth, 0);\nflatPts = List.Flatten(drawn, -1);\nflatHidden = List.Flatten(asmHidden, -1);\nasmVisiblePoints = List.FilterByBoolMask(flatPts, flatHidden)[\"out\"];\nasmHiddenPoints = List.FilterByBoolMask(flatPts, flatHidden)[\"in\"];\n// Make2D on the same solid and camera, drawn at the same place (Creases and Silhouettes repeated below)\nm = Plotter.Make2D.ByCamera([solid], eye, target, null, fov, 0, meshTol);\ndiagnostics = m.Diagnostics;\nmake2dVisible = m.VisibleLines.ToPolyCurve().Translate(offset, 0, 0);\nmake2dCreases = m.Creases.ToPolyCurve().Translate(offset, -1.6 * side, 0);\nmake2dSilhouettes = m.Silhouettes.ToPolyCurve().Translate(offset + 1.6 * side, -1.6 * side, 0);\ncounts = [List.Count(asmVisiblePoints), List.Count(asmHiddenPoints), List.Count(m.Creases), List.Count(m.Silhouettes)];\n// Exact engine input written for replay in the test suite (python tests/make2d/replay_capture.py)\ncaptured = m.ExportTestCase(captureFolder, \"verify\");"
    }
  ],
