      ],
      "Replication": "Disabled",
      "Description": "Allows for DesignScript code to be authored directly",
      "Code": "// Base block, 60 x 60 x 20\nCuboid.ByLengths(CoordinateSystem.ByOrigin(0, 0, 10), 60, 60, 20);\n// Cylinder standing on the block\nCylinder.ByPointsRadius(Point.ByCoordinates(0, 0, 20), Point.ByCoordinates(0, 0, 75), 15);\n// Sphere resting on the ground\nSphere.ByCenterPointRadius(Point.ByCoordinates(46, -40, 12), 12);\n// Cone behind\nCone.ByPointsRadius(Point.ByCoordinates(-48, 42, 0), Point.ByCoordinates(-48, 42, 50), 16);\n// Block with a spherical cavity: occlusion inside the bowl\nCuboid.ByLengths(CoordinateSystem.ByOrigin(-48, -42, 14), 28, 28, 28).Difference(Sphere.ByCenterPointRadius(Point.ByCoordinates(-48, -42, 30), 17));\n// Staircase of boxes: contact shadows at every step\nCuboid.ByLengths(CoordinateSystem.ByOrigin(18 + (0..5) * 8, 48, 2 + (0..5) * 2), 8, 16, 4 + (0..5) * 4);"
    },
