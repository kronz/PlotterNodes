    {
      "ConcreteType": "Dynamo.Graph.Nodes.ZeroTouch.DSFunction, DynamoCore",
      "Id": "a9027960ecdf41f8a3b7c6cb4683d577",
      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "74d03a32ed374ef2a4aa48bbbfa2acdc",
          "Name": "geometry",
          "Description": "Solids, surfaces, polysurfaces, meshes and curves (nested lists allowed).\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "a6264a28219d4217bc951d1aa8c3993d",
          "Name": "viewDirection",
          "Description": "Direction of view, from the viewer into the scene. Default (0, 0, -1) is the plan view.\n\nVector\nDefault value : Autodesk.DesignScript.Geometry.Vector.ByCoordinates(0, 0, -1)",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "4413afecbbe3459d92ff52509b10551d",
          "Name": "upVector",
          "Description": "World direction that becomes drawing +y. Default: world Z, or world Y for plan views.\n\nVector\nDefault value : null",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "61998752874c4c0694f7b2cd806c53e5",
          "Name": "meshTolerance",
          "Description": "Mesh deviation for solids and surfaces in model units; -1 lets Dynamo choose. Smaller gives smoother silhouettes and more triangles.\n\ndouble\nDefault value : -1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "b87629d9bd594fe0ad98920fc3a0604f",
          "Name": "creaseAngle",
          "Description": "Edges folding more than this angle (degrees) are drawn. For solids and surfaces only their real (B-rep) edges qualify: the default 20 hides tangent edges such as fillet boundaries, 0 shows them. For meshes every mesh edge is tested.\n\ndouble\nDefault value : 20",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "d8fcc8502edc4ef0944806987249228b",
          "Name": "mergeTolerance",
          "Description": "Lines closer than this (drawing units) count as one; 0 uses a tiny automatic value.\n\ndouble\nDefault value : 0",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "134ca80b66674331ac4d337a4d18121b",
          "Name": "Make2D",
          "Description": "Make2D",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Plotter.Make2D.ByDirection@var[]..[],Autodesk.DesignScript.Geometry.Vector,Autodesk.DesignScript.Geometry.Vector,double,double,double",
      "Replication": "Auto",
      "Description": "Projects geometry along a view direction with hidden lines removed (parallel projection, like Rhino's Make2D with the Top, Front or an isometric view). Solids, surfaces and polysurfaces are meshed with Mesh.ByGeometry; meshes are used as they are; curves are projected and tested against the surfaces. Drawing x points to the right and y up on the image plane; the world origin projects to (0, 0).\n\nMake2D.ByDirection (geometry: var[]..[], viewDirection: Vector = Autodesk.DesignScript.Geometry.Vector.ByCoordinates(0, 0, -1), upVector: Vector = null, meshTolerance: double = -1, creaseAngle: double = 20, mergeTolerance: double = 0): Make2D"
    },
