      "NodeType": "FunctionNode",
      "Inputs": [
        {
          "Id": "597f076792f8439785b7171ae9ccb46d",
          "Name": "geometry",
          "Description": "Solids, surfaces, polysurfaces, meshes and curves (nested lists allowed).\n\nvar[]..[]",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "e627871aab4e43b28d7baab9eec935b6",
          "Name": "eyePoint",
          "Description": "Camera position.\n\nPoint",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "da0530e6d7274eebb2c226fa011ba1cf",
          "Name": "targetPoint",
          "Description": "Point the camera looks at; it projects to (0, 0).\n\nPoint",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "bcc7f141f91142adb346de36b194efa0",
          "Name": "upVector",
          "Description": "World direction that becomes drawing +y. Default: world Z.\n\nVector\nDefault value : null",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "9b83f123a32546c89a33247eb6cd3441",
          "Name": "fieldOfView",
          "Description": "Full view angle in degrees of the square window (a 50 mm lens is about 40, a wide angle 90).\n\ndouble\nDefault value : 60",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "dfdac108cdbb4102b209b4cf1e80f159",
          "Name": "imagePlaneDistance",
          "Description": "Distance from the eye to the image plane in model units; 0 uses the eye-target distance.\n\ndouble\nDefault value : 0",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "6ec3fedd481340908145eb7a6ac6df0e",
          "Name": "meshTolerance",
          "Description": "Mesh deviation for solids and surfaces in model units; -1 lets Dynamo choose.\n\ndouble\nDefault value : -1",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "f1a88362d7384286b1c44a62b0021c96",
          "Name": "creaseAngle",
          "Description": "Edges folding more than this angle (degrees) are drawn. For solids and surfaces only their real (B-rep) edges qualify: the default 20 hides tangent edges such as fillet boundaries, 0 shows them. For meshes every mesh edge is tested.\n\ndouble\nDefault value : 20",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        },
        {
          "Id": "28bf27610fad455790991f8a5cf79084",
          "Name": "mergeTolerance",
          "Description": "Lines closer than this (drawing units) count as one; 0 uses a tiny automatic value.\n\ndouble\nDefault value : 0",
          "UsingDefaultValue": true,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "Outputs": [
        {
          "Id": "70b9d38ec1ee4802952d3aa22711f317",
          "Name": "Make2D",
          "Description": "Make2D",
          "UsingDefaultValue": false,
          "Level": 2,
          "UseLevels": false,
          "KeepListStructure": false
        }
      ],
      "FunctionSignature": "Plotter.Make2D.ByCamera@var[]..[],Autodesk.DesignScript.Geometry.Point,Autodesk.DesignScript.Geometry.Point,Autodesk.DesignScript.Geometry.Vector,double,double,double,double,double",
      "Replication": "Auto",
      "Description": "Perspective drawing of geometry from a camera with hidden lines removed (Rhino's Make2D in a perspective viewport). Lines are drawn where they pierce the image plane, a plane perpendicular to the eye-target line at imagePlaneDistance from the eye, so objects at that distance appear at true size. The field of view clips the drawing to a square window; Frame returns it.\n\nMake2D.ByCamera (geometry: var[]..[], eyePoint: Point, targetPoint: Point, upVector: Vector = null, fieldOfView: double = 60, imagePlaneDistance: double = 0, meshTolerance: double = -1, creaseAngle: double = 20, mergeTolerance: double = 0): Make2D"
    },
