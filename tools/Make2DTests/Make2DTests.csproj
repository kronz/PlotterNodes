<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Runs the C# Make2D engine on the standalone test suite (tests/make2d). Built in shim mode like
    tools/Smoke (no Dynamo binaries needed); build.ps1 -Make2DTests does everything:
      python tests/make2d/suite.py generate
      dotnet run (two dashes)project tools/Make2DTests/Make2DTests.csproj -c Release
        -p:DynamoServicesShim=[full path]/tools/DynamoServicesShim/DynamoServicesShim.csproj
        -p:UseDynamoGeometry=false -p:SkipPackage=true -p:DynamoRepo=[path to Dynamo checkout]
      python tests/make2d/suite.py evaluate (two dashes)engine csharp
  -->

  <PropertyGroup>
    <DotNet Condition="'$(DotNet)' == ''">net10.0</DotNet>
    <TargetFramework>$(DotNet)</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlotterNodes\PlotterNodes.csproj" />
    <ProjectReference Include="..\DynamoServicesShim\DynamoServicesShim.csproj" />
  </ItemGroup>

</Project>
