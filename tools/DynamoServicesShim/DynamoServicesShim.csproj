<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Minimal stand-in for DynamoServices.dll used ONLY for headless builds and smoke tests
    where NuGet / a Dynamo install is unavailable. It compiles the real attribute and
    IGraphicItem definitions straight from the Dynamo repository, so the API surface is
    identical to what Dynamo loads. Never ship this assembly in a package.

    Set DynamoRepo to the root of a Dynamo checkout (defaults to a sibling folder named Dynamo).
  -->

  <PropertyGroup>
    <DotNet Condition="'$(DotNet)' == ''">net10.0</DotNet>
    <TargetFramework>$(DotNet)</TargetFramework>
    <AssemblyName>DynamoServices</AssemblyName>
    <RootNamespace>Autodesk.DesignScript</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS1591;CS1573;CS1572</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <DynamoRepo Condition="'$(DynamoRepo)' == ''">$(MSBuildThisFileDirectory)..\..\..\Dynamo</DynamoRepo>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="$(DynamoRepo)\src\NodeServices\Attributes.cs" Link="Attributes.cs" />
    <Compile Include="$(DynamoRepo)\src\NodeServices\GraphicsDataInterfaces.cs" Link="GraphicsDataInterfaces.cs" />
  </ItemGroup>

</Project>
