<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Headless renderer for samples/Numerals/*.dyn. Numerals.g.cs is generated by
    tools/make_numeral_graphs.py from the same recipes as the graphs. Build it like the smoke
    test (DynamoServices shim, no ProtoGeometry); build.ps1 -Smoke runs it after the smoke test.
  -->

  <PropertyGroup>
    <DotNet Condition="'$(DotNet)' == ''">net10.0</DotNet>
    <TargetFramework>$(DotNet)</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PlotterNodes\PlotterNodes.csproj" />
    <ProjectReference Include="..\DynamoServicesShim\DynamoServicesShim.csproj" />
  </ItemGroup>

</Project>
